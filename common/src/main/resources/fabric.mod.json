{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["${mod_authors}"],
    "contact": {},
    "license": "${mod_license}",
    "icon": "assets/fullbright/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.mayank.fullbright.FullBrightClient"
        ]
    },
    "mixins": [
        {
            "config": "fullbright.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.16.0",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}